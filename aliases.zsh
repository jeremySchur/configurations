# Config Files
alias aliases='code ~/.oh-my-zsh/custom/aliases.zsh'
alias zshconfig='code ~/.zshrc'
alias p10kconfig='code ~/.p10k.zsh'

# General
alias cl='clear'
alias ls='ls -l'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias gco='git checkout'
alias gcb='git checkout -b'
